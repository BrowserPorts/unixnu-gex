# 64-bit Wine's pins: the Wine fork's commit make wine builds (wine/dist.sh),
# and the commit of the 32-bit Wine tree its wineserver is still compiled
# with (wine/Makefile build). The Unix libraries are in libs.pins, musl in
# toolchain/pins. wine/dist.sh builds the Wine tree it is given and says so
# when that tree is not at WINE64_COMMIT.

# The Wine fork: wine-stellite, branch stellite (the 64-bit Wine work with Stellite's own: WoW64's
# LPC layout, winlogon, the shared-block file copies).
WINE64_REPO   := https://github.com/BrowserPorts/wine-stellite.git
WINE64_COMMIT := bfe0c0b1cc99f6558b48615a177db396ce23e721

# The 32-bit Wine tree (branch wasm32-w3-next): the wineserver's build, and
# the legacy 32-bit dist (make wine32).
WINE_REPO   := https://github.com/MercuryWorkshop/wine-wasm.git
WINE_COMMIT := 5ae68e95f71b4af62e080237b6a6d8172bc0b916

# Wine Mono for the 64-bit install (wine/dist.sh with WINE64_MONO=1): the
# version must be the one mscoree asks for (WINE_MONO_VERSION in
# dlls/mscoree/mscoree_private.h), which dist.sh checks. The x86 tarball
# carries both halves; WoW64 keeps both.
WINE_MONO_VERSION := 11.2.0
WINE_MONO_URL     := https://dl.winehq.org/wine/wine-mono/11.2.0/wine-mono-11.2.0-x86.tar.xz
WINE_MONO_SHA256  := c9fb2e2823acf30b000b8806177db0f40751786136dd3f8fb2be7897b1643d06
